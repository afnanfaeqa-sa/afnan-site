# Rep subdomains: every request goes to index.php, which picks the rep from the host name.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<FilesMatch "^(reps|data)\.json$">
  Require all denied
</FilesMatch>
# PHP parts only run through index.php
<FilesMatch "^(lib|dashboard)\.php$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(themes/.*\.php|\.data/) - [F,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} \.afnanfaeqasa\.sa$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
