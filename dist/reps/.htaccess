# Rep subdomains: every request goes to index.php, which picks the rep from the host name.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex"
</IfModule>
<Files "reps.json">
  Require all denied
</Files>
<Files "data.json">
  Require all denied
</Files>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} \.afnanfaeqasa\.sa$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
