# Rep subdomains: every request goes to index.php, which picks the rep from the host name.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<Files "reps.json">
  Require all denied
</Files>
RewriteEngine On
# the page templates are only served through index.php (it fills in the rep's number)
RewriteRule ^site/ - [F,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} \.afnanfaeqasa\.sa$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
